{
  "NDVI": {
    "name": "Normalized Difference Vegetation Index",
    "displayMin": -0.2,
    "displayMax": 0.8,
    "stops": [
      { "value": -0.2, "color": "#8C510A", "label": "Very low / non-vegetated" },
      { "value": 0.0, "color": "#D8B365", "label": "Bare / little vegetation" },
      { "value": 0.2, "color": "#F6E8A6", "label": "Sparse vegetation" },
      { "value": 0.4, "color": "#A6D96A", "label": "Moderate vegetation" },
      { "value": 0.6, "color": "#4D9221", "label": "Healthy vegetation" },
      { "value": 0.8, "color": "#1B5E20", "label": "Dense vegetation" }
    ]
  },
  "NDWI": {
    "name": "Normalized Difference Water Index",
    "displayMin": -0.5,
    "displayMax": 0.5,
    "stops": [
      { "value": -0.5, "color": "#A6611A", "label": "Dry land" },
      { "value": -0.25, "color": "#DFC27D", "label": "Land" },
      { "value": 0.0, "color": "#F5F5F5", "label": "Land / water transition" },
      { "value": 0.15, "color": "#ABD9E9", "label": "Likely water" },
      { "value": 0.3, "color": "#4393C3", "label": "Water" },
      { "value": 0.5, "color": "#2166AC", "label": "Strong water response" }
    ]
  },
  "MNDWI": {
    "name": "Modified Normalized Difference Water Index",
    "displayMin": -0.5,
    "displayMax": 0.5,
    "stops": [
      { "value": -0.5, "color": "#B2182B", "label": "Built-up / dry surface" },
      { "value": -0.25, "color": "#EF8A62", "label": "Land" },
      { "value": 0.0, "color": "#F7F7F7", "label": "Land / water transition" },
      { "value": 0.15, "color": "#92C5DE", "label": "Likely water" },
      { "value": 0.3, "color": "#4393C3", "label": "Water" },
      { "value": 0.5, "color": "#2166AC", "label": "Strong water response" }
    ]
  },
  "NDBI": {
    "name": "Normalized Difference Built-up Index",
    "displayMin": -0.5,
    "displayMax": 0.5,
    "stops": [
      { "value": -0.5, "color": "#2166AC", "label": "Strong negative response" },
      { "value": -0.25, "color": "#92C5DE", "label": "Vegetated / non-built" },
      { "value": 0.0, "color": "#F7F7F7", "label": "Transition" },
      { "value": 0.15, "color": "#FDAE61", "label": "Likely built-up" },
      { "value": 0.3, "color": "#F46D43", "label": "Built-up" },
      { "value": 0.5, "color": "#B2182B", "label": "Strong built-up response" }
    ]
  },
  "NBR": {
    "name": "Normalized Burn Ratio",
    "displayMin": -1.0,
    "displayMax": 1.0,
    "stops": [
      { "value": -1.0, "color": "#3B0F0F", "label": "Very low NBR" },
      { "value": -0.5, "color": "#A63603", "label": "Low / strongly disturbed" },
      { "value": -0.2, "color": "#E6550D", "label": "Low NBR" },
      { "value": 0.0, "color": "#FEC44F", "label": "Neutral / sparse vegetation" },
      { "value": 0.3, "color": "#C2E699", "label": "Moderate vegetation" },
      { "value": 0.6, "color": "#78C679", "label": "Healthy vegetation" },
      { "value": 1.0, "color": "#238443", "label": "Very high NBR" }
    ]
  },
  "NDRE": {
    "name": "Normalized Difference Red Edge Index",
    "displayMin": 0.0,
    "displayMax": 0.8,
    "stops": [
      { "value": 0.0, "color": "#762A83", "label": "Very low vegetation response" },
      { "value": 0.15, "color": "#C51B7D", "label": "Low vegetation response" },
      { "value": 0.3, "color": "#F1B6DA", "label": "Low to moderate vegetation response" },
      { "value": 0.4, "color": "#F7F7B9", "label": "Moderate vegetation response" },
      { "value": 0.55, "color": "#A6D96A", "label": "Healthy vegetation" },
      { "value": 0.7, "color": "#4D9221", "label": "High vegetation response" },
      { "value": 0.8, "color": "#1B5E20", "label": "Very high vegetation response" }
    ]
  }
}